{
  "expo": {
    "name": "Impulse",
    "slug": "impulse",
    "scheme": "impulse",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": { "supportsTablet": true, "bundleIdentifier": "app.impulse.mobile" },
    "android": { "package": "app.impulse.mobile" },
    "plugins": ["expo-router", "expo-secure-store"],
    "experiments": { "typedRoutes": false }
  }
}
