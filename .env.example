# Local API
ALLOW_DEV_AUTH=true
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=.data/impulse.db
TOKEN_PEPPER=replace-with-a-long-random-string

# Google OAuth via Supabase. Leave blank to use development sign-in.
# SUPABASE_SERVICE_ROLE_KEY is not read by anything yet (there is no Postgres
# runtime adapter). If it is ever used, it must stay on the server and never go
# in the mobile app or the Chrome extension.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional OpenAI-compatible chat completions API. Without a key, onboarding
# and insights use the deterministic fallback.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional SMS. Without these, approval links are returned for the share sheet
# and iOS Messages composer. They are never sent automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Public URLs baked into clients. These are not secrets.
# VITE_* values are read by the extension build from apps/extension/.env or the shell.
EXPO_PUBLIC_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
# Optional: web app URL for the popup's "Account settings" link (defaults to VITE_API_URL).
VITE_APP_URL=
