{
  "expo": {
    "name": "snuff",
    "slug": "snuff-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.snuff.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0302",
        "foregroundImage": "./assets/icon.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.snuff.mobile",
      "blockedPermissions": ["android.permission.WRITE_CONTACTS"]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-font",
      "expo-image",
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0B0302",
          "image": "./assets/icon.png",
          "imageWidth": 180
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FFD66B",
          "defaultChannel": "quiet",
          "icon": "./assets/notification-icon.png"
        }
      ],
      [
        "expo-contacts",
        {
          "contactsPermission": "Allow Snuff to show your contacts so you can choose friends to add. Only selected contacts are saved on this device."
        }
      ]
    ],
    "scheme": "snuff"
  }
}
