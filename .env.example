# Local API
ALLOW_DEV_AUTH=true
APP_BASE_URL=http://localhost:3000
DATABASE_PATH=.data/impulse.db
TOKEN_PEPPER=replace-with-a-long-random-string

# Google OAuth via Supabase. Leave blank to use development sign-in.
# SUPABASE_SERVICE_ROLE_KEY must stay on the server. Never put it in the
# mobile app or the Chrome extension.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional OpenAI-compatible chat completions API. Without a key, onboarding
# and insights use the deterministic fallback.
AI_API_KEY=
AI_API_BASE=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# Optional SMS. Without these, approval links are returned for the share sheet
# and iOS Messages composer. They are never sent automatically.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Public URLs baked into clients. These are not secrets.
EXPO_PUBLIC_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
